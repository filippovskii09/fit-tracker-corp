      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git *--no-verify*)",
      "Bash(git config *)",
      "Bash(gh pr merge *)",
      "Bash(npm run *--watch*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Edit(/.agents/**)",
      "Write(/.agents/**)",
