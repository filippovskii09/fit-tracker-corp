      "Bash(git push -u origin filippovskii/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)",
      "Bash(npm run --silent backlog -- *)",
      "Bash(npm run test*)",
