      "Glob",
      "Grep",
      "Skill",
      "Edit(/frontend/**)",
      "Write(/frontend/**)",
      "Edit(/backend/**)",
      "Write(/backend/**)",
      "Edit(/openspec/**)",
      "Write(/openspec/**)",
      "Edit(/docs/**)",
      "Write(/docs/**)",
      "Agent(proposal-reviewer)",
      "Agent(fe-implementer)",
      "Agent(fe-reviewer)",
      "Agent(be-implementer)",
      "Agent(be-reviewer)",
      "Agent(test-writer)",
      "Agent(test-reviewer)",
      "Agent(test-fixer)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git symbolic-ref *)",
      "Bash(git merge-base *)",
      "Bash(git ls-remote *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin feat/*)",
