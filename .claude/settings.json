      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run format*)",
      "Bash(npx --no-install eslint *)",
      "Bash(npx --no-install prettier *)",
      "Bash(npx --no-install tsc *)",
      "Bash(npx --no-install jest *)",
      "Bash(openspec new change *)",
